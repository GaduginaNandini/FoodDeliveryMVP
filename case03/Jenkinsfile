pipeline {
    agent any

    parameters {
        choice(name: 'TARGET', choices: ['fixed', 'original'],
               description: 'Select application version')
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir("case03/${params.TARGET}") {
                    sh "python3 -m venv ../.venv-${params.TARGET}"
                    sh ". ../.venv-${params.TARGET}/bin/activate && pip install -r ../fixed/requirements.txt"

                    script {
                        if (params.TARGET == 'original') {
                            sh 'rm -rf labs_tests'
                            sh 'cp -r ../fixed/labs_tests labs_tests'
                            sh 'rm -f labs_tests/run_tests.sh'
                        }
                    }

                    sh ". ../.venv-${params.TARGET}/bin/activate && python manage.py check"
                }
            }
        }

        stage('Test') {
            steps {
                dir("case03/${params.TARGET}") {
                    sh ". ../.venv-${params.TARGET}/bin/activate && python manage.py test labs_tests.test_ai10 labs_tests.test_cart_order labs_tests.test_equivalence -v 2"
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression { params.TARGET == 'fixed' }
            }
            steps {
                dir('case03/fixed') {
                    script {
                        def scannerHome = tool 'SonarScanner'

                        withSonarQubeEnv('SonarQube') {
                            sh """
                                "\${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=quickbite \
                                -Dsonar.projectName=QuickBite \
                                -Dsonar.sources=. \
                                -Dsonar.exclusions=**/migrations/**,**/__pycache__/**,**/*.pyc,**/.venv/**,**/venv/**
                            """
                        }
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir("case03/${params.TARGET}") {
                    sh "zip -qr ../foodmvp-${env.BUILD_NUMBER}.zip config orders restaurants static manage.py"
                }

                archiveArtifacts(
                    artifacts: 'case03/foodmvp-*.zip',
                    fingerprint: true
                )
            }
        }
    }

    post {
        failure {
            echo 'Build failed.'
        }
        success {
            echo 'Build, tests, SonarQube analysis and packaging completed successfully.'
        }
    }
}